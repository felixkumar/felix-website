<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_delivery_charge" string="Add Delivery Charge" type="object" class="btn-primary"/>
                <button name="action_calculate_distance"
                        type="object"
                        string="Calculate Distance"
                        class="btn-primary"
                        icon="fa-map-marker"/>
                <button name="send_order_confirmation_whatsapp"
                        type="object"
                        string="Send Message"
                        class="btn-primary"
                        icon="fa-map-marker"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="computed_delivery_charge" readonly="1"/>
                <field name="delivery_distance_km"/>
                <field name="store_latitude"/>
                <field name="store_longitude"/>
                <field name="customer_latitude"/>
                <field name="customer_longitude"/>
            </xpath>
        </field>
    </record>

