<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lbmart.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <div class="app_settings_block"
                     data-string="LB Mart Delivery"
                     string="LB Mart Delivery"
                     data-key="lbmart_delivery">

                    <h2>LB Mart Delivery Charge Rules</h2>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">

                            <div class="o_setting_left_pane">
                            </div>

                            <div class="o_setting_right_pane">

                                <label for="delivery_tier1_max"
                                       string="Orders below ₹150"/>

                                <div class="text-muted">
                                    Delivery Charge: ₹30
                                </div>

                                <div class="content-group mt16">
                                    <div class="row">
                                        <label for="delivery_tier1_max"
                                               class="col-lg-6 o_light_label"/>
                                        <div class="col-lg-6">
                                            <field name="delivery_tier1_max"/>
                                        </div>
                                    </div>

                                    <div class="row mt8">
                                        <label for="delivery_tier1_fee"
                                               class="col-lg-6 o_light_label"/>
                                        <div class="col-lg-6">
                                            <field name="delivery_tier1_fee"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">

                            <div class="o_setting_right_pane">

                                <label for="delivery_tier2_max"
                                       string="Orders ₹150 to ₹399"/>

                                <div class="text-muted">
                                    Delivery Charge: ₹25
                                </div>

                                <div class="content-group mt16">
                                    <div class="row">
                                        <label for="delivery_tier2_max"
                                               class="col-lg-6 o_light_label"/>
                                        <div class="col-lg-6">
                                            <field name="delivery_tier2_max"/>
                                        </div>
                                    </div>

                                    <div class="row mt8">
                                        <label for="delivery_tier2_fee"
                                               class="col-lg-6 o_light_label"/>
                                        <div class="col-lg-6">
                                            <field name="delivery_tier2_fee"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">

                            <div class="o_setting_right_pane">

                                <label for="delivery_free_threshold"
                                       string="Free Delivery"/>

                                <div class="text-muted">
                                    Orders ₹400 and above are free.
                                </div>

                                <div class="content-group mt16">
                                    <div class="row">
                                        <label for="delivery_free_threshold"
                                               class="col-lg-6 o_light_label"/>
                                        <div class="col-lg-6">
                                            <field name="delivery_free_threshold"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">

    <div class="o_setting_left_pane">
    </div>

    <div class="o_setting_right_pane">

        <div class="o_form_label">
            24x7 Customer Support
        </div>

        <div class="text-muted">
            Contact details displayed to customers in the mobile application.
        </div>

        <div class="content-group mt16">

            <div class="row">
                <label for="support_email"
                       string="Support Email"
                       class="col-lg-3 o_light_label"/>

                <div class="col-lg-9">
                    <field name="support_email"
                           placeholder="support@example.com"/>
                </div>
            </div>

            <div class="row mt8">
                <label for="support_phone"
                       string="Contact Number"
                       class="col-lg-3 o_light_label"/>

                <div class="col-lg-9">
                    <field name="support_phone"
                           placeholder="+91 XXXXX XXXXX"/>
                </div>
            </div>

        </div>

    </div>

</div>
                        <div class="col-12 col-lg-12 o_setting_box">

    <div class="o_setting_left_pane">
    </div>

    <div class="o_setting_right_pane">

        <label for="terms_and_conditions"
               string="Terms &amp; Conditions"/>

        <div class="text-muted">
            Enter the terms and conditions displayed to customers.
        </div>

        <div class="content-group mt16">
            <field name="terms_and_conditions"
                   widget="html"
                   nolabel="1"/>
        </div>

    </div>

</div>

                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>