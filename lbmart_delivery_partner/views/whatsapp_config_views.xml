<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Form View -->
    <record id="view_whatsapp_config_form" model="ir.ui.view">
        <field name="name">whatsapp.config.form</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <form string="WhatsApp API Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone_number_id"/>
                        <field name="access_token" password="True"/>
                        <field name="api_version"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Tree / List View -->
    <record id="view_whatsapp_config_tree" model="ir.ui.view">
        <field name="name">whatsapp.config.tree</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <list string="WhatsApp API Configurations">
                <field name="name"/>
                <field name="phone_number_id"/>
                <field name="api_version"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- 3. Action Window -->
    <record id="action_whatsapp_config" model="ir.actions.act_window">
        <field name="name">WhatsApp Configurations</field>
        <field name="res_model">whatsapp.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your Meta WhatsApp API credentials here.
            </p>
        </field>
    </record>

    <!-- 4. Menu Item under Settings -->
    <menuitem id="menu_whatsapp_config_root"
              name="WhatsApp API"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="menu_whatsapp_config_item"
              name="API Configurations"
              parent="menu_whatsapp_config_root"
              action="action_whatsapp_config"
              sequence="10"/>
</odoo>